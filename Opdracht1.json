        "format": "<template>\n  <div>\n    <h2>Relais State</h2>\n    \n    <div class=\"mt-3\">\n      <label>\n        <!-- VOEG value=\"1\" TOE EN GEBRUIK :checked -->\n        <input type=\"checkbox\" :checked=\"checked\" @change=\"onChange\" />\n        Status\n      </label>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() { \n    return { checked: false } \n  },\n  methods: { \n    onChange(event) {\n      // Lees de echte status uit van de checkbox in de DOM\n      this.checked = event.target.checked;\n      \n      // Stuur 1 of 0\n      this.send({ payload: this.checked ? 1 : 0 });\n    }\n  }\n}\n</script>",
